# Local Postgres (matches docker-compose.yml). In Vercel/production these two
# variable names are supplied automatically by the Vercel <-> Supabase
# integration (Storage tab -> Connect Database -> Supabase), which is why the
# Prisma schema reads these specific names rather than plain DATABASE_URL.
DATABASE_POSTGRES_PRISMA_URL="postgresql://docdocs:docdocs@localhost:5432/docdocs?schema=public"
DATABASE_POSTGRES_URL_NON_POOLING="postgresql://docdocs:docdocs@localhost:5432/docdocs?schema=public"

# HMAC signing key for the mocked-auth session cookie. Any value works
# locally; set a long random string (e.g. `openssl rand -hex 32`) in
# production.
AUTH_SECRET="local-dev-secret-change-me"
